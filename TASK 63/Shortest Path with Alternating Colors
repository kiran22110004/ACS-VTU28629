import java.util.*;

class Solution {

    public int[] shortestAlternatingPaths(
            int n,
            int[][] redEdges,
            int[][] blueEdges) {

        // graph[node][0] = red neighbors
        // graph[node][1] = blue neighbors
        List<List<Integer>>[] graph = new ArrayList[2];

        graph[0] = new ArrayList<>();
        graph[1] = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            graph[0].add(new ArrayList<>());
            graph[1].add(new ArrayList<>());
        }

        // Red edges
        for (int[] edge : redEdges) {
            graph[0].get(edge[0]).add(edge[1]);
        }

        // Blue edges
        for (int[] edge : blueEdges) {
            graph[1].get(edge[0]).add(edge[1]);
        }

        // distance[node][color]
        // color 0 = red
        // color 1 = blue
        int[][] distance = new int[n][2];

        for (int i = 0; i < n; i++) {
            Arrays.fill(distance[i], -1);
        }

        // At node 0, we can start with either color
        distance[0][0] = 0;
        distance[0][1] = 0;

        // Queue: {node, lastColor}
        Queue<int[]> queue = new LinkedList<>();

        // We haven't used an edge yet,
        // so we can pretend the previous edge was either color.
        queue.offer(new int[]{0, 0});
        queue.offer(new int[]{0, 1});

        while (!queue.isEmpty()) {

            int[] current = queue.poll();

            int node = current[0];
            int lastColor = current[1];

            // Next edge must have the opposite color
            int nextColor = 1 - lastColor;

            for (int next : graph[nextColor].get(node)) {

                // If not visited with this color
                if (distance[next][nextColor] == -1) {

                    distance[next][nextColor] =
                            distance[node][lastColor] + 1;

                    queue.offer(
                            new int[]{next, nextColor}
                    );
                }
            }
        }

        // Final answer
        int[] answer = new int[n];

        for (int i = 0; i < n; i++) {

            if (distance[i][0] == -1) {
                answer[i] = distance[i][1];
            } else if (distance[i][1] == -1) {
                answer[i] = distance[i][0];
            } else {
                answer[i] = Math.min(
                        distance[i][0],
                        distance[i][1]
                );
            }
        }

        return answer;
    }
}


