class Solution {
    public void sortColors(int[] nums) {
        int low = 0;
        int mid = 0;
        int high = nums.length - 1;

        while (mid <= high) {
            if (nums[mid] == 0) {
                // Swap nums[low] and nums[mid], move both forward
                swap(nums, low, mid);
                low++;
                mid++;
            } else if (nums[mid] == 1) {
                // 1 is already in its correct middle region
                mid++;
            } else { // nums[mid] == 2
                // Swap nums[mid] and nums[high], shrink the high boundary
                swap(nums, mid, high);
                high--;
                // Do not increment mid here because the newly swapped element at mid must be checked
            }
        }
    }

    private void swap(int[] nums, int i, int j) {
        int temp = nums[i];
        nums[i] = nums[j];
        nums[j] = temp;
    }
}



