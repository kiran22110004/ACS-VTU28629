class Solution {
    public int findJudge(int n, int[][] trust) {
        
        int[] count = new int[n + 1];

        for (int[] t : trust) {
            int a = t[0];
            int b = t[1];

            // a trusts someone → a cannot be the judge
            count[a]--;

            // b is trusted by someone → increase count
            count[b]++;
        }

        // Judge must be trusted by n - 1 people
        // and must trust nobody
        for (int person = 1; person <= n; person++) {
            if (count[person] == n - 1) {
                return person;
            }
        }

        return -1;
    }
}




