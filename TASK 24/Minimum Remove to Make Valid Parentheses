import java.util.ArrayDeque;
import java.util.Deque;

class Solution {
    public String minRemoveToMakeValid(String s) {
        char[] chars = s.toCharArray();
        Deque<Integer> stack = new ArrayDeque<>(); // Holds indices of unmatched '('

        for (int i = 0; i < chars.length; i++) {
            if (chars[i] == '(') {
                stack.push(i);
            } else if (chars[i] == ')') {
                if (!stack.isEmpty()) {
                    stack.pop(); // Matched with an earlier '('
                } else {
                    chars[i] = '\0'; // Invalid ')' marked for removal
                }
            }
        }

        // Any remaining '(' in the stack have no matching ')'
        while (!stack.isEmpty()) {
            chars[stack.pop()] = '\0'; // Mark unmatched '(' for removal
        }

        // Construct the result string skipping marked characters
        StringBuilder result = new StringBuilder();
        for (char c : chars) {
            if (c != '\0') {
                result.append(c);
            }
        }

        return result.toString();
    }
}


