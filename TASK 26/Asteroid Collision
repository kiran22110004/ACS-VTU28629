import java.util.*;

class Solution {
    public int[] asteroidCollision(int[] asteroids) {
        
        Stack<Integer> stack = new Stack<>();

        for (int asteroid : asteroids) {
            
            boolean destroyed = false;

            // Collision can happen only when:
            // top is moving right and current asteroid is moving left
            while (!stack.isEmpty() && stack.peek() > 0 && asteroid < 0) {
                
                int top = stack.peek();

                if (top < -asteroid) {
                    // Top asteroid is smaller, so it explodes
                    stack.pop();
                } 
                else if (top == -asteroid) {
                    // Both are same size, so both explode
                    stack.pop();
                    destroyed = true;
                    break;
                } 
                else {
                    // Current asteroid is smaller, so it explodes
                    destroyed = true;
                    break;
                }
            }

            // Add current asteroid if it survived
            if (!destroyed) {
                stack.push(asteroid);
            }
        }

        // Convert stack to array
        int[] result = new int[stack.size()];

        for (int i = 0; i < stack.size(); i++) {
            result[i] = stack.get(i);
        }

        return result;
    }
}



