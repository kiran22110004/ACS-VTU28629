//PROGRAM
class Solution {
    public int[] getSumAbsoluteDifferences(int[] nums) {
        int n = nums.length;
        int[] result = new int[n];
        
        int totalSum = 0;
        for (int num : nums) {
            totalSum += num;
        }
        
        int prefixSum = 0;
        for (int i = 0; i < n; i++) {
            int leftSum = prefixSum;
            int rightSum = totalSum - prefixSum - nums[i];
            
            // Absolute difference sum for left elements + right elements
            result[i] = (nums[i] * i - leftSum) + (rightSum - nums[i] * (n - 1 - i));
            
            prefixSum += nums[i];
        }
        
        return result;
    }
}


