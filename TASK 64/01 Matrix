import java.util.*;

class Solution {

    public int[][] updateMatrix(int[][] mat) {

        int m = mat.length;
        int n = mat[0].length;

        Queue<int[]> queue = new LinkedList<>();

        // Add all 0s to the queue
        // and mark 1s as unvisited (-1)
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {

                if (mat[i][j] == 0) {
                    queue.offer(new int[]{i, j});
                } else {
                    mat[i][j] = -1;
                }
            }
        }

        // Four directions
        int[][] directions = {
            {-1, 0},  // up
            {1, 0},   // down
            {0, -1},  // left
            {0, 1}    // right
        };

        // Multi-source BFS
        while (!queue.isEmpty()) {

            int[] current = queue.poll();

            int row = current[0];
            int col = current[1];

            for (int[] dir : directions) {

                int newRow = row + dir[0];
                int newCol = col + dir[1];

                // Check boundaries
                if (newRow >= 0 && newRow < m &&
                    newCol >= 0 && newCol < n &&
                    mat[newRow][newCol] == -1) {

                    // Distance = current distance + 1
                    mat[newRow][newCol] = mat[row][col] + 1;

                    queue.offer(new int[]{newRow, newCol});
                }
            }
        }

        return mat;
    }
}


